#!/usr/bin/env bash
#
# git-gone — safely delete local branches whose upstream is gone.
#
# A branch is a delete candidate when:
#   * it once tracked a remote branch, AND
#   * that remote branch no longer exists (i.e. PR merged + auto-deleted).
#
# Branches that were never pushed have NO upstream, so they never show up
# here — your unpushed WIP is protected by construction.
#
# Flow: fetch --prune -> list candidates oldest-first (branch, date, author)
# -> walk them one-by-one with a per-branch y/n/a/q prompt -> delete on the
# spot. No all-or-nothing batch step.
#
# Usage:
#   git gone            # base branch = main (or master fallback)
#   git gone develop    # use a different base branch
#   git gone -n         # dry run: list only, never delete
#
set -euo pipefail

# --- args -------------------------------------------------------------------
DRY_RUN=0
BASE=""
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -*)           echo "unknown flag: $arg" >&2; exit 2 ;;
    *)            BASE="$arg" ;;
  esac
done

# --- sanity -----------------------------------------------------------------
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "not a git repo" >&2; exit 1
}

# pick base branch: explicit arg > main > master
if [ -z "$BASE" ]; then
  if git show-ref --verify --quiet refs/heads/main; then
    BASE=main
  elif git show-ref --verify --quiet refs/heads/master; then
    BASE=master
  else
    echo "no main/master found; pass a base branch explicitly" >&2; exit 1
  fi
fi

CURRENT=$(git symbolic-ref --quiet --short HEAD || echo "")
PROTECTED="main master develop $BASE $CURRENT"

# --- refresh remote state ---------------------------------------------------
echo "› git fetch --prune"
git fetch --prune --quiet

# --- collect candidates -----------------------------------------------------
# One for-each-ref pass, sorted oldest tip first, carrying everything we need:
# track state, branch, committer date, author, short hash, subject. Fields are
# tab-separated (git subjects/authors don't contain tabs).
TAB=$'\t'
mapfile -t RECORDS < <(
  git for-each-ref --sort=committerdate \
    --format="%(upstream:track)${TAB}%(refname:short)${TAB}%(committerdate:short)${TAB}%(authorname)${TAB}%(objectname:short)${TAB}%(contents:subject)" \
    refs/heads
)

# keep only [gone] upstreams, minus protected branches
FILTERED=()
for rec in "${RECORDS[@]:-}"; do
  [ -z "$rec" ] && continue
  IFS="$TAB" read -r track branch _cdate _author _hash _subject <<<"$rec"
  [ "$track" = "[gone]" ] || continue
  skip=0
  for p in $PROTECTED; do [ "$branch" = "$p" ] && skip=1; done
  [ "$skip" -eq 0 ] && FILTERED+=("$rec")
done

if [ "${#FILTERED[@]}" -eq 0 ]; then
  echo "✓ nothing to clean — no branches with a gone upstream."
  exit 0
fi

# --- report -----------------------------------------------------------------
# Note: we deliberately do NOT flag "commits not in $BASE". With squash-merge
# the squashed commit has a new SHA, so a cleanly-merged branch always shows
# its original commits as "missing" — the check is pure noise here. The gone
# upstream is the trustworthy signal: remote branch deleted => PR merged.
echo
echo "Candidates (oldest first; upstream gone => PR merged & remote deleted):"
echo
for rec in "${FILTERED[@]}"; do
  IFS="$TAB" read -r _track branch cdate author hash subject <<<"$rec"
  printf "  · %-34s %s  %-16s %s  %s\n" "$branch" "$cdate" "$author" "$hash" "$subject"
done
echo

if [ "$DRY_RUN" -eq 1 ]; then
  echo "(dry run — nothing deleted)"
  exit 0
fi

# --- walk & delete ----------------------------------------------------------
# Per-branch prompt, oldest first, immediate delete. Vocabulary mirrors
# `git add -p`: y/n/a/q, with ? for help. Empty or unrecognized input keeps
# the branch (safe default). EOF on stdin is treated as quit.
assume_yes=0
quit=0
deleted=0
total=${#FILTERED[@]}

for rec in "${FILTERED[@]}"; do
  IFS="$TAB" read -r _track branch _cdate _author _hash _subject <<<"$rec"

  if [ "$assume_yes" -eq 1 ]; then
    git branch -D "$branch" >/dev/null && echo "  deleted $branch"
    deleted=$((deleted + 1))
    continue
  fi

  while true; do
    printf "Delete branch '%s'? [y,n,a,q,?] " "$branch"
    if ! IFS= read -r reply; then reply=q; fi
    case "$reply" in
      y|Y)
        git branch -D "$branch" >/dev/null && echo "  deleted $branch"
        deleted=$((deleted + 1)); break ;;
      a|A)
        git branch -D "$branch" >/dev/null && echo "  deleted $branch"
        deleted=$((deleted + 1)); assume_yes=1; break ;;
      q|Q)
        quit=1; break ;;
      n|N|"")
        break ;;
      \?)
        printf '  y - delete this branch\n  n - keep it, next\n  a - delete this and all remaining\n  q - quit, keep the rest\n' ;;
      *)
        : ;;  # unrecognized -> re-ask
    esac
  done

  [ "$quit" -eq 1 ] && break
done

echo "✓ deleted $deleted, kept $((total - deleted))"
